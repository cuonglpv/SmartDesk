---
title: SmartDesk — full ERD (every table except tenants and users carries tenant_id; tenant edges hidden)
---
erDiagram
    TENANTS {
        uuid id PK
        varchar slug UK
        varchar name
        varchar plan
        tenant_status status
        varchar timezone
        jsonb working_hours
        timestamptz suspended_at
        text suspended_reason
        int row_version
        timestamptz created_at
        timestamptz updated_at
    }
    TENANT_COUNTERS {
        uuid tenant_id PK
        varchar counter_name PK
        bigint next_value
    }
    USERS {
        uuid id PK
        varchar email
        text password_hash
        varchar full_name
        varchar phone
        varchar avatar_url
        user_status status
        boolean is_platform_admin
        timestamptz password_changed_at
        timestamptz last_login_at
        int failed_login_count
        timestamptz locked_until
        int row_version
        timestamptz created_at
        timestamptz updated_at
    }
    DEPARTMENTS {
        uuid id PK
        uuid tenant_id
        varchar name
        boolean is_active
        int row_version
        timestamptz created_at
        timestamptz updated_at
    }
    LOCATIONS {
        uuid id PK
        uuid tenant_id
        varchar name
        text address
        boolean is_active
        int row_version
        timestamptz created_at
        timestamptz updated_at
    }
    MEMBERSHIPS {
        uuid id PK
        uuid tenant_id
        uuid user_id FK
        uuid department_id FK "nullable"
        membership_status status
        varchar job_title
        uuid location_id FK "nullable"
