        timestamptz invite_expires_at
        timestamptz invited_at
        timestamptz joined_at
        timestamptz locked_at
        int row_version
        timestamptz created_at
        timestamptz updated_at
    }
    MEMBERSHIP_ROLES {
        uuid membership_id PK, FK
        role_code role PK
        timestamptz granted_at
    }
    USER_SESSIONS {
        uuid id PK
        uuid user_id FK
        uuid tenant_id
