Project SmartDesk {
  database_type: 'PostgreSQL'
  Note: '''
  Proposed logical schema for the SmartDesk multi-tenant SaaS (revision 2).

  Conventions
  - UUID primary keys (gen_random_uuid(), or UUIDv7 generated by the app); every timestamp is timestamptz in UTC.
  - Every tenant-owned table carries tenant_id. Foreign keys between tenant-owned tables are composite
    (tenant_id, x_id) -> parent(tenant_id, id), so a row can never point at another tenant's data.
  - Business records are never hard-deleted (status / is_active / retired_at instead). Foreign keys therefore
    default to NO ACTION; ON DELETE CASCADE is declared only for pure child rows (roles of a membership,
    messages of a conversation, chunks of a KB version, ...). SET NULL is never used on composite keys.
  - Closed state sets are enums. Open-ended codes (notification_type, audit action) stay varchar.
  - updated_at is maintained by a shared BEFORE UPDATE trigger.
  - Rules DBML cannot express (partial unique indexes, exclusion constraints, immutability triggers)
    are written in the Note of the table they belong to.
  - Extensions: pgcrypto (gen_random_uuid on PG < 13), btree_gist, vector (pgvector).
  '''
}

// ============================================================
// ENUMS
// ============================================================
Enum tenant_status {
  ACTIVE
  SUSPENDED
}

Enum user_status {
  PENDING [note: 'Created by an invitation; no password yet']
  ACTIVE
  DISABLED
}

Enum membership_status {
  INVITED
  ACTIVE
  LOCKED
}

Enum token_purpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

Enum ticket_kind {
  INCIDENT
  SERVICE_REQUEST
  CHANGE
}

Enum catalog_version_status {
  DRAFT
  PUBLISHED
  RETIRED
}

Enum ticket_status {
  SUBMITTED
  TRIAGED
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_FULFILMENT
  DRAFT
  ASSESSING
  SCHEDULED
  IMPLEMENTED
  RESOLVED
  REOPENED
  CLOSED
  CANCELLED
}

Enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum ticket_source {
  PORTAL
  AI_ASSISTANT
}

Enum comment_visibility {
  PUBLIC
  INTERNAL
}

Enum attachment_scan_status {
  PENDING
  CLEAN
  INFECTED
}

Enum ticket_event_type {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  TRANSFERRED
  ESCALATED
  PRIORITY_CHANGED
  LINKED
  UNLINKED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  SLA_WARNING
  SLA_BREACHED
}

Enum ticket_link_type {
  RELATED
  DUPLICATE_OF
  CAUSED_BY
}

Enum approval_status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

Enum fulfilment_step_status {
  PENDING
  DONE
  SKIPPED
}

Enum asset_status {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RETIRED
  LOST
}

Enum kb_visibility {
  ALL_EMPLOYEES
  IT_ONLY
}

Enum kb_version_status {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

Enum ai_sender {
  USER
  ASSISTANT
  TOOL
}

Enum ai_draft_status {
  DRAFT
  SUBMITTED
  DISCARDED
}

Enum change_risk_level {
  LOW
  MEDIUM
  HIGH
}

Enum audit_scope {
  TENANT
  PLATFORM
}

// ============================================================
// 1. PLATFORM, IDENTITY, ORGANIZATION
// ============================================================
Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar(100) [not null, unique]
  name varchar(200) [not null]
  plan varchar(30) [not null, default: 'FREE']
  status tenant_status [not null, default: 'ACTIVE']
  timezone varchar(80) [not null, default: 'Asia/Ho_Chi_Minh']
  suspended_at timestamptz [note: 'Last suspension; kept after reopening']
  suspended_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `status <> 'SUSPENDED' OR (suspended_at IS NOT NULL AND suspended_reason IS NOT NULL)` [name: 'ck_tenants_suspension_reason']
  }
}

Table tenant_counters {
  tenant_id uuid [not null, ref: > tenants.id]
  counter_name varchar(30) [not null, note: 'e.g. INC, SR, CHG']
  next_value bigint [not null, default: 1]
  indexes {
    (tenant_id, counter_name) [pk]
  }
  Note: 'ticket_no is allocated with UPDATE ... SET next_value = next_value + 1 RETURNING next_value, in the same transaction as the ticket insert.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null]
  password_hash text [note: 'NULL until the invited user sets a password; never plaintext']
  full_name varchar(150) [not null]
  phone varchar(30)
  status user_status [not null, default: 'PENDING']
  password_changed_at timestamptz
  last_login_at timestamptz
  failed_login_count int [not null, default: 0]
  locked_until timestamptz [note: 'Temporary lock after repeated failed logins']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (`lower(email)`) [unique, name: 'ux_users_email_ci']
  }
  checks {
    `status <> 'ACTIVE' OR password_hash IS NOT NULL` [name: 'ck_users_active_has_password']
    `failed_login_count >= 0` [name: 'ck_users_failed_login_count']
  }
}

Table user_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  purpose token_purpose [not null]
  token_hash text [not null, unique, note: 'Hash of the one-time token; the raw token is only sent by email']
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, purpose)
  }
}

Table platform_admins {
  user_id uuid [pk, ref: > users.id]
  granted_by_user_id uuid [ref: > users.id]
  granted_at timestamptz [not null, default: `now()`]
}

Table departments {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(120) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, name) [unique]
  }
}

Table memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  user_id uuid [not null, ref: > users.id]
  department_id uuid
  status membership_status [not null, default: 'INVITED']
  job_title varchar(120)
  location varchar(150)
  invited_at timestamptz
  joined_at timestamptz
  locked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, user_id) [unique]
    (user_id) [name: 'ix_memberships_user', note: 'Login: list the tenants of a user']
  }
  checks {
    `status <> 'LOCKED' OR locked_at IS NOT NULL` [name: 'ck_memberships_locked_at']
  }
}

Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  membership_id uuid [not null, note: 'The INVITED membership; its roles are already in membership_roles']
  email varchar(255) [not null, note: 'Address the link was sent to']
  token_hash text [not null, unique]
  invited_by_membership_id uuid [not null]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, membership_id)
  }
  checks {
    `accepted_at IS NULL OR revoked_at IS NULL` [name: 'ck_invitations_single_outcome']
  }
  Note: 'Partial unique: UNIQUE (membership_id) WHERE accepted_at IS NULL AND revoked_at IS NULL — one live invitation per membership.'
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique, note: 'EMPLOYEE, IT_STAFF, IT_MANAGER, ORG_ADMIN (seeded, global)']
  name varchar(100) [not null]
}

Table membership_roles {
  membership_id uuid [not null]
  role_id uuid [not null]
  granted_at timestamptz [not null, default: `now()`]
  indexes {
    (membership_id, role_id) [pk]
    (role_id)
  }
}

Table user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  tenant_id uuid [ref: > tenants.id, note: 'NULL only for platform-admin sessions']
  refresh_token_hash text [not null, unique]
  user_agent varchar(400)
  ip_address inet
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, expires_at)
  }
  Note: 'Composite FK (tenant_id, user_id) -> memberships guarantees a tenant session belongs to a real membership. Login is refused while tenants.status = SUSPENDED or memberships.status <> ACTIVE (resolve the deny vs read-only question first).'
}

Table it_teams {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(120) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, name) [unique]
  }
}

Table it_team_members {
  tenant_id uuid [not null, ref: > tenants.id]
  team_id uuid [not null]
  membership_id uuid [not null]
  joined_at timestamptz [not null, default: `now()`]
  indexes {
    (team_id, membership_id) [pk]
    (tenant_id, membership_id)
  }
  Note: 'Backend check: the membership holds IT_STAFF or IT_MANAGER.'
}

// ============================================================
// 2. SERVICE CATALOG AND DYNAMIC FORMS
// ============================================================
Table catalog_items {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(50) [not null]
  kind ticket_kind [not null, note: 'Immutable after creation (trigger)']
  is_visible boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, id, kind) [unique, note: 'Target of catalog_versions (tenant_id, catalog_item_id, kind)']
    (tenant_id, code) [unique]
  }
}

Table catalog_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  catalog_item_id uuid [not null]
  kind ticket_kind [not null, note: 'Always equals catalog_items.kind (composite FK)']
  version_no int [not null]
  title varchar(200) [not null]
  description text
  form_schema jsonb [not null, note: 'Field definitions, required flags, validation rules']
  routing_team_id uuid
  status catalog_version_status [not null, default: 'DRAFT']
  created_by_membership_id uuid [not null]
  published_by_membership_id uuid
  published_at timestamptz
  retired_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, id, kind) [unique, note: 'Target of tickets (tenant_id, catalog_version_id, kind)']
    (catalog_item_id, version_no) [unique]
  }
  checks {
    `version_no > 0` [name: 'ck_catalog_versions_version_no']
    `status = 'DRAFT' OR (published_at IS NOT NULL AND published_by_membership_id IS NOT NULL)` [name: 'ck_catalog_versions_published']
    `status <> 'RETIRED' OR retired_at IS NOT NULL` [name: 'ck_catalog_versions_retired']
  }
  Note: '''
  - Partial unique: UNIQUE (catalog_item_id) WHERE status = 'PUBLISHED' — at most one live version per item.
  - Trigger: once status <> 'DRAFT' the row is immutable, except PUBLISHED -> RETIRED.
  - There is no needs_approval flag: whether a ticket needs approval is decided only by approval_rules.
  '''
}

Table approval_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  catalog_item_id uuid [not null]
  name varchar(150) [not null]
  step_no int [not null, default: 1, note: 'Order of approval steps']
  approver_role_id uuid [ref: > roles.id, note: 'Role-based approver, typically IT_MANAGER']
  approver_membership_id uuid [note: 'Named approver']
  conditions jsonb [not null, default: `'{}'::jsonb`, note: 'Condition expression evaluated by the trusted backend; {} = always']
  effective_from timestamptz [not null, default: `now()`]
  effective_to timestamptz
  created_by_membership_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, catalog_item_id, effective_from)
  }
  checks {
    `(approver_role_id IS NULL) <> (approver_membership_id IS NULL)` [name: 'ck_approval_rules_one_approver']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'ck_approval_rules_period']
    `step_no > 0` [name: 'ck_approval_rules_step_no']
  }
  Note: '''
  Append-only: to change a rule, set effective_to and insert a new row, so ticket_approvals always point at the
  exact rule that was applied. A ticket needs approval iff at least one rule effective at submission matches it.
  '''
}

// ============================================================
// 3. TICKETS AND TIMELINE
// ============================================================
Table tickets {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_no varchar(30) [not null, note: 'Allocated from tenant_counters, e.g. INC-000123']
  kind ticket_kind [not null, note: 'Equals the kind of catalog_version_id (composite FK)']
  source ticket_source [not null, default: 'PORTAL']
  requester_membership_id uuid [not null]
  catalog_version_id uuid [not null]
  title varchar(200) [not null]
  description text
  form_answers jsonb [not null, note: 'Validated against the immutable catalog_versions.form_schema']
  priority ticket_priority [not null, default: 'MEDIUM']
  status ticket_status [not null, note: 'Initial value set by the backend per kind: SUBMITTED, or DRAFT for CHANGE']
  assigned_team_id uuid
  assigned_membership_id uuid
  resolution_note text
  idempotency_key varchar(100)
  row_version int [not null, default: 0, note: 'Optimistic locking']
  resolved_at timestamptz
  closed_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, id, kind) [unique, note: 'Target for kind-specific child tables']
    (tenant_id, id, requester_membership_id) [unique, note: 'Target of ai_ticket_drafts submitted ticket check']
    (tenant_id, ticket_no) [unique]
    (tenant_id, requester_membership_id, idempotency_key) [unique]
    (tenant_id, requester_membership_id, created_at) [name: 'ix_tickets_my_tickets']
    (tenant_id, status, priority) [name: 'ix_tickets_queue']
    (tenant_id, assigned_membership_id, status) [name: 'ix_tickets_assigned_to_me']
    (tenant_id, assigned_team_id, status) [name: 'ix_tickets_team_queue']
  }
  checks {
    `(kind = 'INCIDENT' AND status IN ('SUBMITTED','TRIAGED','IN_PROGRESS','WAITING_FOR_EMPLOYEE','RESOLVED','REOPENED','CLOSED','CANCELLED')) OR (kind = 'SERVICE_REQUEST' AND status IN ('SUBMITTED','PENDING_APPROVAL','APPROVED','REJECTED','IN_FULFILMENT','RESOLVED','CLOSED','CANCELLED')) OR (kind = 'CHANGE' AND status IN ('DRAFT','ASSESSING','PENDING_APPROVAL','SCHEDULED','IMPLEMENTED','REJECTED','CLOSED','CANCELLED'))` [name: 'ck_tickets_status_per_kind']
    `resolved_at IS NULL OR resolution_note IS NOT NULL` [name: 'ck_tickets_resolution_note']
    `status <> 'CANCELLED' OR cancelled_at IS NOT NULL` [name: 'ck_tickets_cancelled_at']
    `row_version >= 0` [name: 'ck_tickets_row_version']
  }
  Note: '''
  - The check above only guarantees a status is valid for the kind; the allowed transitions (state machines in
    docs/02-use-cases.md) are validated by the backend in the same transaction that writes ticket_events.
  - Backend checks: assignee holds IT_STAFF/IT_MANAGER and belongs to assigned_team_id;
    only the requester may confirm resolution or reopen within 7 days.
  '''
}

Table ticket_comments {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  author_membership_id uuid [not null]
  visibility comment_visibility [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  edited_at timestamptz
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, ticket_id, id) [unique, note: 'Lets attachments prove their comment is on the same ticket']
    (tenant_id, ticket_id, created_at)
  }
  Note: 'INTERNAL comments are never returned by requester-facing endpoints or AI tools.'
}

Table ticket_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  comment_id uuid [note: 'If set, must be a comment of the same ticket (composite FK)']
  uploaded_by_membership_id uuid [not null]
  file_name varchar(255) [not null]
  content_type varchar(100) [not null]
  size_bytes bigint [not null]
  sha256 char(64)
  storage_key text [not null, unique, note: 'Private object storage key, not a public URL']
  scan_status attachment_scan_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, ticket_id)
  }
  checks {
    `size_bytes > 0` [name: 'ck_ticket_attachments_size']
  }
  Note: 'Downloads are served only when scan_status = CLEAN.'
}

Table ticket_events {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  actor_membership_id uuid [note: 'NULL for system automation']
  event_type ticket_event_type [not null]
  old_status ticket_status
  new_status ticket_status
  reason text
  details jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, ticket_id, created_at)
  }
  checks {
    `event_type <> 'STATUS_CHANGED' OR new_status IS NOT NULL` [name: 'ck_ticket_events_new_status']
    `new_status IS NULL OR new_status NOT IN ('REJECTED','REOPENED','CANCELLED') OR reason IS NOT NULL` [name: 'ck_ticket_events_status_reason']
    `event_type NOT IN ('TRANSFERRED','ESCALATED') OR reason IS NOT NULL` [name: 'ck_ticket_events_transfer_reason']
  }
  Note: 'Append-only: REVOKE UPDATE, DELETE from the application role.'
}

Table ticket_links {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  source_ticket_id uuid [not null]
  target_ticket_id uuid [not null]
  link_type ticket_link_type [not null, default: 'RELATED']
  created_by_membership_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, source_ticket_id, target_ticket_id, link_type) [unique]
    (tenant_id, target_ticket_id)
  }
  checks {
    `source_ticket_id <> target_ticket_id` [name: 'ck_ticket_links_not_self']
    `link_type <> 'RELATED' OR source_ticket_id < target_ticket_id` [name: 'ck_ticket_links_related_once']
  }
  Note: 'RELATED is symmetric, so it is stored once with the smaller id as source.'
}

Table ticket_assets {
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  asset_id uuid [not null]
  linked_by_membership_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (ticket_id, asset_id) [pk]
    (tenant_id, asset_id)
  }
  Note: 'UC22: the ticket is about this device (e.g. a broken laptop). Custody is recorded separately in asset_assignments.'
}

// ============================================================
// 4. APPROVAL AND FULFILMENT
// ============================================================
Table ticket_approvals {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  approval_rule_id uuid [note: 'Rule that created this step; NULL for a manual escalation']
  step_no int [not null, default: 1]
  approver_role_id uuid [ref: > roles.id, note: 'Snapshot of the rule: any member with this role may decide']
  approver_membership_id uuid [note: 'Named approver, or the member who decided a role-based step']
  status approval_status [not null, default: 'PENDING']
  reason text [note: 'Required on rejection']
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, ticket_id, step_no) [unique]
    (tenant_id, approver_membership_id, status) [name: 'ix_approvals_my_pending']
    (tenant_id, approver_role_id, status) [name: 'ix_approvals_role_pending']
  }
  checks {
    `approver_role_id IS NOT NULL OR approver_membership_id IS NOT NULL` [name: 'ck_ticket_approvals_approver']
    `status <> 'REJECTED' OR length(btrim(coalesce(reason, ''))) > 0` [name: 'ck_ticket_approvals_reject_reason']
    `status NOT IN ('APPROVED','REJECTED') OR (decided_at IS NOT NULL AND approver_membership_id IS NOT NULL)` [name: 'ck_ticket_approvals_decided']
    `step_no > 0` [name: 'ck_ticket_approvals_step_no']
  }
  Note: 'Backend checks: the ticket kind is SERVICE_REQUEST or CHANGE; the approver is not the requester; steps are decided in step_no order.'
}

Table fulfilment_steps {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [not null]
  ticket_kind ticket_kind [not null, default: 'SERVICE_REQUEST', note: 'Pinned to SERVICE_REQUEST by check + composite FK']
  step_no int [not null]
  description text [not null]
  status fulfilment_step_status [not null, default: 'PENDING']
  note text
  completed_by_membership_id uuid
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, ticket_id, step_no) [unique]
  }
  checks {
    `ticket_kind = 'SERVICE_REQUEST'` [name: 'ck_fulfilment_steps_kind']
    `step_no > 0` [name: 'ck_fulfilment_steps_step_no']
    `status <> 'DONE' OR (completed_at IS NOT NULL AND completed_by_membership_id IS NOT NULL)` [name: 'ck_fulfilment_steps_done']
  }
  Note: 'Replaces the former 1:1 fulfilment_tasks table: the performer is tickets.assigned_membership_id and start/finish times come from ticket_events.'
}

// ============================================================
// 5. ASSET MANAGEMENT
// ============================================================
Table assets {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  asset_tag varchar(80) [not null]
  asset_type varchar(60) [not null]
  manufacturer varchar(120)
  model varchar(150)
  serial_no varchar(150)
  location varchar(150)
  purchase_date date
  status asset_status [not null, default: 'AVAILABLE']
  condition_note text
  retired_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, asset_tag) [unique]
    (tenant_id, manufacturer, serial_no) [unique]
    (tenant_id, status, asset_type) [name: 'ix_assets_stock']
  }
  checks {
    `status <> 'RETIRED' OR retired_at IS NOT NULL` [name: 'ck_assets_retired_at']
  }
  Note: 'status = ASSIGNED is a cached flag, changed in the same transaction as the asset_assignments insert/return; a trigger keeps ASSIGNED <=> an open assignment exists. After a return the asset goes back to AVAILABLE (RETURNED is an assignment state, not an asset state).'
}

Table asset_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  asset_id uuid [not null]
  holder_membership_id uuid [not null]
  ticket_id uuid [note: 'Service request that authorised the handover']
  handed_over_by_membership_id uuid [not null]
  handed_over_at timestamptz [not null, default: `now()`]
  condition_at_handover text
  returned_at timestamptz
  returned_by_membership_id uuid
  condition_at_return text
  indexes {
    (tenant_id, asset_id, handed_over_at) [name: 'ix_asset_assignments_history']
    (tenant_id, holder_membership_id, returned_at) [name: 'ix_asset_assignments_my_assets']
  }
  checks {
    `returned_at IS NULL OR returned_at >= handed_over_at` [name: 'ck_asset_assignments_period']
    `(returned_at IS NULL) = (returned_by_membership_id IS NULL)` [name: 'ck_asset_assignments_returned_by']
  }
  Note: '''
  - Partial unique: CREATE UNIQUE INDEX ux_asset_open_assignment ON asset_assignments (asset_id) WHERE returned_at IS NULL.
  - Backend check: when ticket_id is set, the ticket is a SERVICE_REQUEST in APPROVED or IN_FULFILMENT.
  '''
}

Table asset_maintenance {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  asset_id uuid [not null]
  ticket_id uuid [note: 'Incident that triggered the repair, if any']
  technician_membership_id uuid [not null]
  description text [not null]
  serviced_at timestamptz [not null]
  status_after asset_status [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, asset_id, serviced_at)
  }
  checks {
    `status_after IN ('AVAILABLE','IN_MAINTENANCE','RETIRED')` [name: 'ck_asset_maintenance_status_after']
  }
  Note: 'Phase 2'
}

// ============================================================
// 6. KNOWLEDGE BASE (VERSIONED, REVIEWED CONTENT)
// ============================================================
Table kb_articles {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  slug varchar(180) [not null]
  topic varchar(100)
  visibility kb_visibility [not null, default: 'ALL_EMPLOYEES']
  created_by_membership_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, slug) [unique]
  }
}

Table kb_article_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  article_id uuid [not null]
  version_no int [not null]
  title varchar(255) [not null]
  content text [not null]
  status kb_version_status [not null, default: 'DRAFT']
  created_by_membership_id uuid [not null]
  submitted_at timestamptz [note: 'Sent for review']
  reviewed_by_membership_id uuid
  reviewed_at timestamptz
  review_comment text [note: 'Change request when the reviewer sends the version back to DRAFT']
  published_by_membership_id uuid
  published_at timestamptz
  retired_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (article_id, version_no) [unique]
    (tenant_id, status)
  }
  checks {
    `version_no > 0` [name: 'ck_kb_versions_version_no']
    `reviewed_by_membership_id IS NULL OR reviewed_by_membership_id <> created_by_membership_id` [name: 'ck_kb_versions_independent_review']
    `status <> 'IN_REVIEW' OR submitted_at IS NOT NULL` [name: 'ck_kb_versions_submitted']
    `status NOT IN ('PUBLISHED','RETIRED') OR (reviewed_by_membership_id IS NOT NULL AND published_by_membership_id IS NOT NULL AND published_at IS NOT NULL)` [name: 'ck_kb_versions_published']
    `status <> 'RETIRED' OR retired_at IS NOT NULL` [name: 'ck_kb_versions_retired']
  }
  Note: '''
  - Partial unique: UNIQUE (article_id) WHERE status = 'PUBLISHED' — one live version per article.
  - Trigger: title/content are immutable once status leaves DRAFT.
  '''
}

Table kb_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  article_version_id uuid [not null]
  chunk_no int [not null]
  content text [not null]
  embedding vector(1536) [not null, note: 'pgvector; dimension follows the embedding model']
  token_count int
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (article_version_id, chunk_no) [unique]
    (tenant_id)
  }
  Note: '''
  AI retrieval index. Rows exist only for PUBLISHED versions: written when a version is published, deleted when it
  is retired. Retrieval always filters tenant_id and the article visibility of the caller.
  Vector index: CREATE INDEX ON kb_chunks USING hnsw (embedding vector_cosine_ops).
  '''
}

Table kb_feedback {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  article_version_id uuid [not null]
  membership_id uuid [not null]
  is_helpful boolean [not null]
  comment text
  submitted_at timestamptz [not null, default: `now()`]
  indexes {
    (article_version_id, membership_id) [unique]
  }
}

// ============================================================
// 7. AI ASSISTANT (AI NEVER SUBMITS TICKETS ON ITS OWN)
// ============================================================
Table ai_conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  membership_id uuid [not null]
  title varchar(200)
  started_at timestamptz [not null, default: `now()`]
  last_message_at timestamptz
  ended_at timestamptz
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, id, membership_id) [unique, note: 'Lets drafts prove they belong to the conversation owner']
    (tenant_id, membership_id, last_message_at)
  }
  Note: 'Retention: conversations older than the tenant retention period are deleted; messages, sources and drafts cascade.'
}

Table ai_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  conversation_id uuid [not null]
  sender ai_sender [not null]
  content text [not null]
  model varchar(80) [note: 'Model id for ASSISTANT messages']
  input_tokens int
  output_tokens int
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, conversation_id, id) [unique]
    (conversation_id, created_at)
  }
}

Table ai_message_sources {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  ai_message_id uuid [not null]
  kb_article_version_id uuid [not null, note: 'Citations point at a version, which survives retirement']
  excerpt text
  indexes {
    (ai_message_id, kb_article_version_id) [unique]
  }
}

Table ai_ticket_drafts {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  conversation_id uuid [not null]
  created_by_membership_id uuid [not null, note: 'Must be the conversation owner (composite FK)']
  source_message_id uuid [note: 'Assistant message that proposed the draft; same conversation (composite FK)']
  catalog_version_id uuid [not null]
  title varchar(200) [not null]
  description text
  proposed_answers jsonb [not null]
  status ai_draft_status [not null, default: 'DRAFT']
  submitted_ticket_id uuid [unique, note: 'Ticket requested by the same member (composite FK)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, conversation_id)
  }
  checks {
    `(status = 'SUBMITTED') = (submitted_ticket_id IS NOT NULL)` [name: 'ck_ai_drafts_submitted_ticket']
  }
  Note: 'The ticket is created only by an explicit employee action, through the same validation as manual submission (tickets.source = AI_ASSISTANT).'
}

// ============================================================
// 8. SLA, NOTIFICATIONS, AUDIT
// ============================================================
Table business_calendars {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(100) [not null]
  timezone varchar(80) [not null]
  working_hours jsonb [not null, note: 'e.g. {"mon": [["08:00","12:00"],["13:00","17:30"]], ...}']
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, name) [unique]
  }
  Note: 'Partial unique: UNIQUE (tenant_id) WHERE is_default.'
}

Table business_holidays {
  tenant_id uuid [not null, ref: > tenants.id]
  calendar_id uuid [not null]
  holiday_date date [not null]
  name varchar(120) [not null]
  indexes {
    (calendar_id, holiday_date) [pk]
  }
}

Table sla_policies {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  catalog_item_id uuid [note: 'NULL = default policy for every request type']
  priority ticket_priority [not null]
  calendar_id uuid [not null]
  response_minutes int [not null]
  resolution_minutes int [not null]
  warning_percent int [not null, default: 80]
  effective_from timestamptz [not null, default: `now()`]
  effective_to timestamptz
  created_by_membership_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, id) [unique]
    (tenant_id, catalog_item_id, priority, effective_from)
  }
  checks {
    `response_minutes > 0 AND resolution_minutes >= response_minutes` [name: 'ck_sla_policies_minutes']
    `warning_percent BETWEEN 1 AND 99` [name: 'ck_sla_policies_warning_percent']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'ck_sla_policies_period']
  }
  Note: '''
  - Append-only: never UPDATE a policy except to set effective_to; changes insert a new row, so ticket_sla keeps the
    exact definition that was applied.
  - No overlapping periods (btree_gist):
    EXCLUDE USING gist (tenant_id WITH =, coalesce(catalog_item_id, '00000000-0000-0000-0000-000000000000'::uuid) WITH =,
    priority WITH =, tstzrange(effective_from, effective_to) WITH &&).
  - Lookup: an item-specific policy wins over the default (catalog_item_id IS NULL).
  '''
}

Table ticket_sla {
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [pk]
  sla_policy_id uuid [not null]
  response_due_at timestamptz [not null]
  resolution_due_at timestamptz [not null]
  first_responded_at timestamptz
  paused_at timestamptz [note: 'Set while WAITING_FOR_EMPLOYEE']
  paused_seconds bigint [not null, default: 0]
  response_warning_sent_at timestamptz
  resolution_warning_sent_at timestamptz
  response_breached_at timestamptz
  resolution_breached_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, resolution_due_at) [name: 'ix_ticket_sla_due']
  }
  checks {
    `paused_seconds >= 0` [name: 'ck_ticket_sla_paused_seconds']
    `resolution_due_at >= response_due_at` [name: 'ck_ticket_sla_due_order']
  }
  Note: 'The SLA job sets *_warning_sent_at / *_breached_at with UPDATE ... WHERE <column> IS NULL, so each threshold notifies once (UC37). Due dates are recomputed when a pause ends.'
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  recipient_membership_id uuid [not null]
  notification_type varchar(40) [not null]
  title varchar(200) [not null]
  body text
  target_type varchar(40)
  target_id uuid [note: 'Polymorphic reference; ownership is checked again on open']
  dedupe_key varchar(150) [note: 'e.g. SLA_WARNING:<ticket_id>:RESOLUTION']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, recipient_membership_id, read_at, created_at) [name: 'ix_notifications_inbox']
    (tenant_id, dedupe_key) [unique]
  }
  checks {
    `(target_type IS NULL) = (target_id IS NULL)` [name: 'ck_notifications_target']
  }
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  scope audit_scope [not null]
  tenant_id uuid [ref: > tenants.id, note: 'Required for TENANT scope; set for platform actions on a tenant']
  actor_user_id uuid [note: 'No FK on purpose: the log must never block user anonymisation']
  actor_membership_id uuid [note: 'No FK on purpose']
  action varchar(60) [not null]
  entity_type varchar(60) [not null]
  entity_id uuid
  ip_address inet
  details jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, created_at)
    (tenant_id, entity_type, entity_id)
    (actor_user_id, created_at)
  }
  checks {
    `scope = 'PLATFORM' OR tenant_id IS NOT NULL` [name: 'ck_audit_logs_tenant_scope']
  }
  Note: '''
  - Append-only: REVOKE UPDATE, DELETE from the application role.
  - PLATFORM entries hold platform metadata only, never ticket contents.
  - Partition by month on created_at when volume grows (the PK then becomes (id, created_at)).
  '''
}

// ============================================================
// 9. CHANGE MANAGEMENT — PHASE 2
// ============================================================
Table change_plans {
  tenant_id uuid [not null, ref: > tenants.id]
  ticket_id uuid [pk]
  ticket_kind ticket_kind [not null, default: 'CHANGE', note: 'Pinned to CHANGE by check + composite FK']
  impact_assessment text [not null]
  risk_level change_risk_level [not null]
  rollback_plan text [not null]
  scheduled_start timestamptz
  scheduled_end timestamptz
  implementation_result text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `ticket_kind = 'CHANGE'` [name: 'ck_change_plans_kind']
    `scheduled_end IS NULL OR scheduled_start IS NULL OR scheduled_end > scheduled_start` [name: 'ck_change_plans_schedule']
  }
  Note: 'Phase 2: internet provider / infrastructure changes'
}

// ============================================================
// RELATIONSHIPS
// Composite keys keep every reference inside one tenant.
// No action specified = NO ACTION (records are not hard-deleted).
// ============================================================

// Identity and organization
Ref: user_tokens.user_id > users.id [delete: cascade]
Ref: memberships.(tenant_id, department_id) > departments.(tenant_id, id)
Ref: invitations.(tenant_id, membership_id) > memberships.(tenant_id, id) [delete: cascade]
Ref: invitations.(tenant_id, invited_by_membership_id) > memberships.(tenant_id, id)
Ref: membership_roles.membership_id > memberships.id [delete: cascade]
Ref: membership_roles.role_id > roles.id
Ref: user_sessions.(tenant_id, user_id) > memberships.(tenant_id, user_id)
Ref: it_team_members.(tenant_id, team_id) > it_teams.(tenant_id, id) [delete: cascade]
Ref: it_team_members.(tenant_id, membership_id) > memberships.(tenant_id, id) [delete: cascade]

// Catalog and approval rules
Ref: catalog_versions.(tenant_id, catalog_item_id, kind) > catalog_items.(tenant_id, id, kind)
Ref: catalog_versions.(tenant_id, routing_team_id) > it_teams.(tenant_id, id)
Ref: catalog_versions.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)
Ref: catalog_versions.(tenant_id, published_by_membership_id) > memberships.(tenant_id, id)
Ref: approval_rules.(tenant_id, catalog_item_id) > catalog_items.(tenant_id, id)
Ref: approval_rules.(tenant_id, approver_membership_id) > memberships.(tenant_id, id)
Ref: approval_rules.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)

// Tickets
Ref: tickets.(tenant_id, catalog_version_id, kind) > catalog_versions.(tenant_id, id, kind)
Ref: tickets.(tenant_id, requester_membership_id) > memberships.(tenant_id, id)
Ref: tickets.(tenant_id, assigned_team_id) > it_teams.(tenant_id, id)
Ref: tickets.(tenant_id, assigned_membership_id) > memberships.(tenant_id, id)
Ref: ticket_comments.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_comments.(tenant_id, author_membership_id) > memberships.(tenant_id, id)
Ref: ticket_attachments.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_attachments.(tenant_id, ticket_id, comment_id) > ticket_comments.(tenant_id, ticket_id, id)
Ref: ticket_attachments.(tenant_id, uploaded_by_membership_id) > memberships.(tenant_id, id)
Ref: ticket_events.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_events.(tenant_id, actor_membership_id) > memberships.(tenant_id, id)
Ref: ticket_links.(tenant_id, source_ticket_id) > tickets.(tenant_id, id)
Ref: ticket_links.(tenant_id, target_ticket_id) > tickets.(tenant_id, id)
Ref: ticket_links.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)
Ref: ticket_assets.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_assets.(tenant_id, asset_id) > assets.(tenant_id, id)
Ref: ticket_assets.(tenant_id, linked_by_membership_id) > memberships.(tenant_id, id)

// Approval and fulfilment
Ref: ticket_approvals.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_approvals.(tenant_id, approval_rule_id) > approval_rules.(tenant_id, id)
Ref: ticket_approvals.(tenant_id, approver_membership_id) > memberships.(tenant_id, id)
Ref: fulfilment_steps.(tenant_id, ticket_id, ticket_kind) > tickets.(tenant_id, id, kind)
Ref: fulfilment_steps.(tenant_id, completed_by_membership_id) > memberships.(tenant_id, id)

// Assets
Ref: asset_assignments.(tenant_id, asset_id) > assets.(tenant_id, id)
Ref: asset_assignments.(tenant_id, holder_membership_id) > memberships.(tenant_id, id)
Ref: asset_assignments.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: asset_assignments.(tenant_id, handed_over_by_membership_id) > memberships.(tenant_id, id)
Ref: asset_assignments.(tenant_id, returned_by_membership_id) > memberships.(tenant_id, id)
Ref: asset_maintenance.(tenant_id, asset_id) > assets.(tenant_id, id)
Ref: asset_maintenance.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: asset_maintenance.(tenant_id, technician_membership_id) > memberships.(tenant_id, id)

// Knowledge base
Ref: kb_articles.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)
Ref: kb_article_versions.(tenant_id, article_id) > kb_articles.(tenant_id, id)
Ref: kb_article_versions.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)
Ref: kb_article_versions.(tenant_id, reviewed_by_membership_id) > memberships.(tenant_id, id)
Ref: kb_article_versions.(tenant_id, published_by_membership_id) > memberships.(tenant_id, id)
Ref: kb_chunks.(tenant_id, article_version_id) > kb_article_versions.(tenant_id, id) [delete: cascade]
Ref: kb_feedback.(tenant_id, article_version_id) > kb_article_versions.(tenant_id, id)
Ref: kb_feedback.(tenant_id, membership_id) > memberships.(tenant_id, id)

// AI assistant
Ref: ai_conversations.(tenant_id, membership_id) > memberships.(tenant_id, id)
Ref: ai_messages.(tenant_id, conversation_id) > ai_conversations.(tenant_id, id) [delete: cascade]
Ref: ai_message_sources.(tenant_id, ai_message_id) > ai_messages.(tenant_id, id) [delete: cascade]
Ref: ai_message_sources.(tenant_id, kb_article_version_id) > kb_article_versions.(tenant_id, id)
Ref: ai_ticket_drafts.(tenant_id, conversation_id, created_by_membership_id) > ai_conversations.(tenant_id, id, membership_id) [delete: cascade]
Ref: ai_ticket_drafts.(tenant_id, conversation_id, source_message_id) > ai_messages.(tenant_id, conversation_id, id) [delete: cascade]
Ref: ai_ticket_drafts.(tenant_id, catalog_version_id) > catalog_versions.(tenant_id, id)
Ref: ai_ticket_drafts.(tenant_id, submitted_ticket_id, created_by_membership_id) > tickets.(tenant_id, id, requester_membership_id)

// SLA and notifications
Ref: business_holidays.(tenant_id, calendar_id) > business_calendars.(tenant_id, id) [delete: cascade]
Ref: sla_policies.(tenant_id, catalog_item_id) > catalog_items.(tenant_id, id)
Ref: sla_policies.(tenant_id, calendar_id) > business_calendars.(tenant_id, id)
Ref: sla_policies.(tenant_id, created_by_membership_id) > memberships.(tenant_id, id)
Ref: ticket_sla.(tenant_id, ticket_id) > tickets.(tenant_id, id)
Ref: ticket_sla.(tenant_id, sla_policy_id) > sla_policies.(tenant_id, id)
Ref: notifications.(tenant_id, recipient_membership_id) > memberships.(tenant_id, id)

// Change management
Ref: change_plans.(tenant_id, ticket_id, ticket_kind) > tickets.(tenant_id, id, kind)

// ============================================================
// TABLE GROUPS (diagram layout on dbdiagram.io)
// ============================================================
TableGroup identity_and_org {
  tenants
  tenant_counters
  users
  user_tokens
  platform_admins
  departments
  memberships
  invitations
  roles
  membership_roles
  user_sessions
  it_teams
  it_team_members
}

TableGroup catalog {
  catalog_items
  catalog_versions
  approval_rules
}

TableGroup ticketing {
  tickets
  ticket_comments
  ticket_attachments
  ticket_events
  ticket_links
  ticket_assets
  ticket_approvals
  fulfilment_steps
  change_plans
}

TableGroup assets_group {
  assets
  asset_assignments
  asset_maintenance
}

TableGroup knowledge_base {
  kb_articles
  kb_article_versions
  kb_chunks
  kb_feedback
}

TableGroup ai_assistant {
  ai_conversations
  ai_messages
  ai_message_sources
  ai_ticket_drafts
}

TableGroup sla_notify_audit {
  business_calendars
  business_holidays
